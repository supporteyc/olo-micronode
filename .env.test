# Variables de la suite de tests. Bun carga este archivo solo al correr `bun test`.
# Mismo motivo que en ec4toast-node: menuConfig.ts lee process.env una sola vez
# al evaluarse, asi que el filtro de los tests tiene que vivir aca y no en el
# .env de cada maquina. Valores falsos: nada de esto es de una tienda real.
MENU_CONFIG=[["Burgers",1,true,true],["Drinks",2,true,true],["Fries Size",3,true,true],["Grupo de mods excluido",1,false,true]]
OLO_ENV=mock
ALMACEN=memoria
SERVICE_TOKEN=
ALERT_WEBHOOK_URL=
TENANT_NAME=Tienda de Prueba
