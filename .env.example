# ==========================================================================
# ec4olo-node - una tienda. Valores FALSOS de ejemplo: no copiar a produccion.
# Todos los intervalos son sugerencias, PENDIENTE DE CONFIRMAR CON OLO.
# ==========================================================================

# ---------- Base de datos (lado POS de la tienda, distinta de la de OnSign) ----------
DATABASE_URL="mysql://usuario:password@host:3306/base_de_la_tienda"
# mysql | memoria. Sin definir: mysql si hay DATABASE_URL. memoria esta prohibido con OLO_ENV=production.
ALMACEN=

# ---------- Servidor ----------
PORT=8080
TENANT_NAME="Tienda de Ejemplo"
# Webhook de alertas: todo console.error dispara un POST aca.
ALERT_WEBHOOK_URL=
# Llave compartida con OnSign y ec4-console (header X-EC4-Key). Vacia = /api abierto.
SERVICE_TOKEN=""
# Valor de `side` en /api/status. "toast" hasta que el console acepte "olo". [PEDIR-A-ANDRES]
STATUS_SIDE=toast
# true para ver los eventos ignorados en /api/logs.
LOG_DEBUG=false

# ---------- Filtro del menu (mismo formato que ec4toast-node) ----------
# [["Categoria u optiongroup de Olo", numeroDeMenu, incluirItems, incluirSubgrupos], ...]
# Para descubrir las categorias: GET /api/toast/menu-categories
MENU_CONFIG=[["Burgers",1,true,true],["Drinks",2,true,true]]

# ---------- Freno de borrado (mismos nombres que ec4toast-node) ----------
MAX_DELETE_RATIO=0.5
DELETE_GUARD_MIN_ROWS=10

# ---------- Olo: Ordering API v1.1 ----------
# mock | sandbox | production. mock arranca sin credenciales.
OLO_ENV=mock
# Opcional: por defecto la del ambiente (https://ordering.api.olo.com/v1.1/ en production).
OLO_BASE_URL=
OLO_CLIENT_ID=
OLO_CLIENT_SECRET=
# partner + brand / version
OLO_USER_AGENT=EyeCatchNetworks/v1
# Id del restaurante de esta tienda en Olo (VendorId = locationId de los webhooks).
OLO_VENDOR_ID=10000000000000001
OLO_STORE_TIMEZONE=America/New_York
# Si el path firmado incluye /v1.1/. [VALIDAR-CON-OLO]
OLO_SIGN_PATH_WITH_VERSION=true
OLO_TIMEOUT_MS=20000
OLO_MAX_RETRIES=3

# ---------- Ciclo de stock ----------
# Ciclo de salud (no llama a Olo). Alias aceptado: TOAST_SYNC_INTERVAL_MS.
SYNC_INTERVAL_MS=78000
# Reconciliacion con eightysixeditems: 300000 a 900000 (5 a 15 min).
OLO_RECONCILE_INTERVAL_MS=600000
# Alerta si una reconciliacion corrige MAS de N filas.
OLO_RECONCILE_ALERT_ROWS=5
# Alerta si N reconciliaciones seguidas corrigen filas.
OLO_RECONCILE_ALERT_CONSECUTIVE=3
# Respaldo diario del Vendor Export, HH:mm hora de la tienda. Vacio = sin respaldo.
OLO_EXPORT_DAILY_AT=04:00
# Sin webhooks durante este tiempo se reconcilia por las dudas (3 h).
OLO_WEBHOOK_SILENCE_ALERT_MS=10800000
# Dos deltas del mismo item en menos de esto programan una linea base de verificacion.
OLO_FLAP_WINDOW_MS=60000
OLO_FLAP_RECHECK_MS=30000
# Niveles de optiongroups que se aplanan (1 = solo los del producto). [PEDIR-A-ANDRES]
OLO_MODIFIER_DEPTH=1
# trigger_source de la importacion por VendorMenuExportComplete: scheduler | webhook. [PEDIR-A-ANDRES]
OLO_WEBHOOK_TRIGGER_SOURCE=scheduler

# ---------- OCB ----------
OCB_PICKED_UP_HIDE_AFTER_MIN=2
OCB_CANCELLED_HIDE_AFTER_MIN=1
OCB_MAX_TTL_MIN=120
OCB_SHOW_READY_ON_CLOSED=true
# Tiendas sin Expo: minutos desde OrderClosed hasta retirar. Vacio = la tienda usa Expo.
OCB_HIDE_ON_CLOSED_AFTER_MIN=
OCB_ADVANCE_THRESHOLD_MIN=45
# IN_PREPARATION | RECEIVED. [PEDIR-A-ANDRES]
OCB_PLACED_STATUS=IN_PREPARATION
# true muestra PICKED_UP y CANCELLED como status propios. [PEDIR-A-ANDRES]
OCB_EXTENDED_STATUS=false
# posRef | orderIdString | firstName. [VALIDAR-CON-OLO]
OCB_DISPLAY_NUMBER_SOURCE=posRef
OCB_SWEEP_INTERVAL_MS=20000
# deliveryMethod que se muestran. Vacio = todos. [PEDIR-A-ANDRES]
OCB_DELIVERY_METHODS=pickup,curbside,dinein

# ==========================================================================
# Solo el receptor (bun run start:hook). Un despliegue para todas las tiendas.
# ==========================================================================
HOOK_PORT=8090
# Archivo de bun:sqlite: TIENE que vivir en un volumen persistente.
HOOK_DB_PATH=.data/hook.sqlite
# Un brand: secreto + Destination URL exacta registrada en el Dashboard de Olo.
OLO_WEBHOOK_SECRET=
OLO_WEBHOOK_URL=https://hook.example.test/olo/webhook
# Varios brands (en lugar de las dos de arriba):
# OLO_HOOK_BRANDS=[{"key":"marca-a","secret":"...","url":"https://hook.example.test/olo/webhook/marca-a"}]
# Id del restaurante -> tienda.
OLO_HOOK_ROUTES={"10000000000000001":{"storeId":"tienda-1","baseUrl":"https://tienda-1.internal.example.test","key":"service-token-de-la-tienda"}}
HOOK_WORKER_INTERVAL_MS=250
HOOK_DELIVERY_TIMEOUT_MS=15000
HOOK_BACKOFF_MAX_MS=300000
HOOK_ALERT_AFTER_ATTEMPTS=5
HOOK_RETENTION_DAYS=7
